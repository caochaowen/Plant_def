extends Resource
class_name WaveUnitData
## =============================================================================
## WaveUnitData（波次单位数据 / Resource）
## -----------------------------------------------------------------------------
## 作用：纯数据资源，描述波次中"可刷出的某种单位"及其出现权重。
## 它作为 WaveData.units 数组的元素，被 WaveData.get_random_unit_scene 用于
## 加权随机选取敌人。
## =============================================================================


## 该单位对应的场景（PackedScene，实例化为 Enemy）。
@export var unit_scene: PackedScene

## 该单位的出现权重（越大越容易被随机选中）。
@export var weight := 0.0
